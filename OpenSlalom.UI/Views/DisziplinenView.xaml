<UserControl x:Class="OpenSlalom.UI.Views.DisziplinenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="White">
    <Border Background="Transparent">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontWeight="Bold" FontSize="20" Text="Disziplin" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Background="#1F84DE" Content="Disziplin anlegen" Width="120" Height="30" Click="OpenCreateDisziplinPage_OnClick" />
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid x:Name="DisziplinenDataGrid"
                          ItemsSource="{Binding DisziplinItems}"
                          Background="Transparent"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          MinRowHeight="36"
                          VerticalContentAlignment="Center"
                          SelectionMode="Single"
                          AlternationCount="2"
                          ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                          CellStyle="{StaticResource StandardDataGridCellStyle}"
                          RowStyle="{StaticResource StandardDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Disziplin" Binding="{Binding Name}" Width="23*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Zeitstrafe TF" Binding="{Binding ZeitstrafeTorfehlerText}" Width="11*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Zeitstrafe PF" Binding="{Binding ZeitstrafePylonenfehlerText}" Width="11*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Altersklassen" Binding="{Binding AltersklassenText}" Width="46*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTemplateColumn Header="Aktionen" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Height="32" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="1" Height="28" Style="{StaticResource RoundedButtonLeft}" Background="#1F84DE" Tag="{Binding Id}" Click="OpenEditDisziplinPage_OnClick">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                                        </Button>
                                        <Button Grid.Column="2" Height="28" Style="{StaticResource RoundedButtonRight}" Background="Red" Tag="{Binding Id}" Click="OpenDeleteDisziplinPage_OnClick">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="DisziplinCreatePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Disziplin anlegen" />
                        <TextBlock Margin="0,16,0,4" Text="Name" />
                        <TextBox x:Name="CreateDisziplinNameTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Zeitstrafe Torfehler (tf) in Sekunden" />
                        <TextBox x:Name="CreateDisziplinTfTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Zeitstrafe Pylonenfehler (pf) in Sekunden" />
                        <TextBox x:Name="CreateDisziplinPfTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Altersklassen" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CreateDisziplinKlasseBezeichnungTextBox" x:FieldModifier="internal" Grid.Column="0" Height="30" ToolTip="Bezeichnung" />
                            <TextBox x:Name="CreateDisziplinKlasseAlterVonTextBox" x:FieldModifier="internal" Grid.Column="2" Height="30" ToolTip="Alter von" />
                            <TextBox x:Name="CreateDisziplinKlasseAlterBisTextBox" x:FieldModifier="internal" Grid.Column="4" Height="30" ToolTip="Alter bis (optional)" />
                            <Button Grid.Column="6" Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="130" Height="30" Click="AddCreateDisziplinAltersklasse_OnClick" Content="Klasse hinzufuegen" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding CreateDisziplinAltersklassenItems}"
                                  Margin="0,10,0,0"
                                  Background="Transparent"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  MinRowHeight="32"
                                  VerticalContentAlignment="Center"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                  CellStyle="{StaticResource StandardDataGridCellStyle}"
                                  RowStyle="{StaticResource StandardDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTextColumn Header="Alter von" Binding="{Binding AlterVon}" Width="120" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTextColumn Header="Alter bis" Binding="{Binding AlterBisText}" Width="120" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTemplateColumn Header="Aktion" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="90"
                                                    Height="24"
                                                    Style="{StaticResource RoundedButton}"
                                                    Background="#DC2626"
                                                    Click="RemoveCreateDisziplinAltersklasse_OnClick"
                                                    Content="Entfernen" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30" Margin="0,0,8,0" Click="CancelDisziplinPage_OnClick" Content="Abbrechen" />
                            <Button Style="{StaticResource RoundedButton}" Background="Green" Width="120" Height="30" Click="SaveCreateDisziplin_OnClick" Content="Speichern" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DisziplinEditPage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Disziplin bearbeiten" />
                        <TextBlock Margin="0,16,0,4" Text="Name" />
                        <TextBox x:Name="EditDisziplinNameTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Zeitstrafe Torfehler (tf) in Sekunden" />
                        <TextBox x:Name="EditDisziplinTfTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Zeitstrafe Pylonenfehler (pf) in Sekunden" />
                        <TextBox x:Name="EditDisziplinPfTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Altersklassen" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EditDisziplinKlasseBezeichnungTextBox" x:FieldModifier="internal" Grid.Column="0" Height="30" ToolTip="Bezeichnung" />
                            <TextBox x:Name="EditDisziplinKlasseAlterVonTextBox" x:FieldModifier="internal" Grid.Column="2" Height="30" ToolTip="Alter von" />
                            <TextBox x:Name="EditDisziplinKlasseAlterBisTextBox" x:FieldModifier="internal" Grid.Column="4" Height="30" ToolTip="Alter bis (optional)" />
                            <Button Grid.Column="6" Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="130" Height="30" Click="AddEditDisziplinAltersklasse_OnClick" Content="Klasse hinzufuegen" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding EditDisziplinAltersklassenItems}"
                                  Margin="0,10,0,0"
                                  Background="Transparent"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  MinRowHeight="32"
                                  VerticalContentAlignment="Center"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                  CellStyle="{StaticResource StandardDataGridCellStyle}"
                                  RowStyle="{StaticResource StandardDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Bezeichnung}" Width="*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTextColumn Header="Alter von" Binding="{Binding AlterVon}" Width="120" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTextColumn Header="Alter bis" Binding="{Binding AlterBisText}" Width="120" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                <DataGridTemplateColumn Header="Aktion" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="90"
                                                    Height="24"
                                                    Style="{StaticResource RoundedButton}"
                                                    Background="#DC2626"
                                                    Click="RemoveEditDisziplinAltersklasse_OnClick"
                                                    Content="Entfernen" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30" Margin="0,0,8,0" Click="CancelDisziplinPage_OnClick" Content="Abbrechen" />
                            <Button Style="{StaticResource RoundedButton}" Background="Green" Width="120" Height="30" Click="SaveEditDisziplin_OnClick" Content="Speichern" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DisziplinDeletePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Disziplin loeschen" />
                        <TextBlock Margin="0,16,0,0" Text="Soll diese Disziplin wirklich geloescht werden?" />
                        <TextBlock x:Name="DeleteDisziplinTextBlock" x:FieldModifier="internal" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30" Margin="0,0,8,0" Click="CancelDisziplinPage_OnClick" Content="Abbrechen" />
                            <Button Width="120" Height="30" Background="#DC2626" Foreground="White" BorderThickness="0" Click="ConfirmDeleteDisziplin_OnClick" Content="Loeschen" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
