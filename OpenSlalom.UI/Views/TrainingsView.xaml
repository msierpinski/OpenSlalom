                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Nummer}" Width="36" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                        <DataGridTextColumn Header="Zeit" Binding="{Binding RundenzeitText}" Width="*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                        <DataGridTextColumn Header="Strafe" Binding="{Binding ZeitstrafeSekunden, Converter={StaticResource ZeitstrafeConverter}}" Width="70" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                        <DataGridTemplateColumn Header="PF" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Width="30" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Pylonen}" /><StackPanel><Button Content="▲" Width="13" Height="17" Padding="0" BorderThickness="0" Background="Transparent" Tag="Pylonen:+1" Click="SecondLapNumericAdjust_OnClick" /><Button Content="▼" Width="13" Height="17" Padding="0" BorderThickness="0" Background="Transparent" Tag="Pylonen:-1" Click="SecondLapNumericAdjust_OnClick" /></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="TF" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Width="30" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Tore}" /><StackPanel><Button Content="▲" Width="13" Height="17" Padding="0" BorderThickness="0" Background="Transparent" Tag="Tore:+1" Click="SecondLapNumericAdjust_OnClick" /><Button Content="▼" Width="13" Height="17" Padding="0" BorderThickness="0" Background="Transparent" Tag="Tore:-1" Click="SecondLapNumericAdjust_OnClick" /></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Ungültig" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding Ungueltig, Mode=TwoWay}" Click="SecondLapInvalidCheckBox_OnClick" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="TrainingFahrerDialogOverlay" x:FieldModifier="internal"
                        Grid.RowSpan="3"
                        Background="#660F172A"
                        Visibility="Collapsed">
                    <Grid>
                        <Border Width="520"
                                Height="600"
                                MaxHeight="760"
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="20" FontWeight="Bold" Text="Fahrer zum Training hinzufügen" />
                                <TextBlock Grid.Row="0" Margin="0,28,0,0" Foreground="#475569" Text="Wähle einen oder mehrere Fahrer aus (auch zum Abwählen)." />

                                <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <ListBox x:Name="TrainingFahrerSelectionListBox" x:FieldModifier="internal"
                                             ItemsSource="{Binding TrainingDriverSelectionItems}"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,4,0,4"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="TrainingDriverSelectionCheckBox_OnClick"
                                                          Content="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBox x:Name="TrainingFahrerSearchTextBox" x:FieldModifier="internal"
                                                 Height="30"
                                                 VerticalAlignment="Center"
                                                 TextChanged="TrainingFahrerSearchTextBox_OnTextChanged"
                                                 ToolTip="Suche nach Fahrername oder Verein" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#94A3B8"
                                                   IsHitTestVisible="False"
                                                   Text="Suche nach Fahrername oder Verein">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=TrainingFahrerSearchTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TrainingFahrerSearchTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="130" Height="30" Margin="0,0,8,0" Content="Abbrechen" Click="CancelAddTrainingFahrerDialog_OnClick" />
                                        <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="130" Height="30" Content="Übernehmen" Click="SaveAddTrainingFahrerDialog_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
