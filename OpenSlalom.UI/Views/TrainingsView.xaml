                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Stint löschen" /><Border Margin="8,0,0,0" Padding="6,1" Background="White" CornerRadius="2"><TextBlock Foreground="Black" FontSize="11" Text="D" /></Border></StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="TrainingSecondSaveStintButton" x:FieldModifier="internal" Style="{StaticResource RoundedButton}" Background="#64748B" Width="110" IsEnabled="False" Content="Stint speichern" Click="SaveSecondTrainingStint_OnClick" HorizontalAlignment="Right" />
