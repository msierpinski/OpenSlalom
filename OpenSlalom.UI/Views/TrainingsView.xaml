                                                <TextBlock VerticalAlignment="Center" Text="⭮ Runde" />
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="2" Background="White">
                                                    <TextBlock Foreground="Black" FontSize="11" Text="W" />
