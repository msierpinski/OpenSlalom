                                                                           GridLinesVisibility="None"
                                                                           BorderThickness="0"
                                                                           RowHeaderWidth="0"
                                                                           MinRowHeight="36"
                                                                           Background="Transparent"
                                                                           ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                                                           CellStyle="{StaticResource StandardDataGridCellStyle}"
                                                                           RowStyle="{StaticResource StandardDataGridRowStyle}">
                                                                     <DataGrid.Columns>
                                                                         <DataGridTextColumn Header="Runde" Binding="{Binding Runde}" Width="65" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                                         <DataGridTextColumn Header="Zeit" Binding="{Binding RundenzeitText}" Width="*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                                         <DataGridTextColumn Header="Zeitstrafe" Binding="{Binding ZeitstrafeSekunden, Converter={StaticResource ZeitstrafeConverter}}" Width="100" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
