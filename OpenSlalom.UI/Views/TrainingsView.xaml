<UserControl x:Class="OpenSlalom.UI.Views.TrainingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1050"
             d:DesignHeight="700"
             d:Background="White">
    <Grid>
        <Border x:Name="TrainingsPage"
                x:FieldModifier="internal"
                Visibility="Collapsed"
                d:Visibility="Visible"
                Background="Transparent">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" FontSize="20" Text="Trainings" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Background="#1F84DE" Style="{StaticResource RoundedButton}" Content="Training anlegen" Width="120"  Height="30" Click="OpenCreateTrainingPage_OnClick" />
                </Grid>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="TrainingsDataGrid" x:FieldModifier="internal"
                              ItemsSource="{Binding TrainingItems}"
                              Background="Transparent"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                               RowHeaderWidth="0"
                               MinRowHeight="36"
                               VerticalContentAlignment="Center"
                               SelectionMode="Single"
                               AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                              CellStyle="{StaticResource StandardDataGridCellStyle}"
                              RowStyle="{StaticResource StandardDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding ZeitpunktText}" Width="80" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="16*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Beschreibung}" Width="20*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Verein" Binding="{Binding VereinName}" Width="16*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Disziplin" Binding="{Binding DisziplinName}" Width="80" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Wetter" Binding="{Binding WetterName}" Width="120" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                             <DataGridTextColumn Header="Finished" Binding="{Binding TrainingAbgeschlossenText}" Width="80" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                             <DataGridTextColumn Header="Veröffentlicht" Binding="{Binding IstVeroeffentlichtText}" Width="95" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTemplateColumn Header="Aktionen" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Height="32" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="1" Height="28"  Style="{StaticResource RoundedButtonLeft}" Background="#1F84DE" Tag="{Binding Id}" Click="OpenDetailTrainingPage_OnClick">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" />
                                            </Button>
                                            <Button Grid.Column="2" Height="28"  Style="{StaticResource Button}" Background="#1F84DE" Tag="{Binding Id}" Click="OpenEditTrainingPage_OnClick">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                                            </Button>
                                            <Button Grid.Column="3"  Height="28" Style="{StaticResource RoundedButtonRight}" Background="Red"  Tag="{Binding Id}" Click="OpenDeleteTrainingPage_OnClick">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                                            </Button>

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="TrainingCreatePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                        <StackPanel Margin="20">
                            <TextBlock FontWeight="Bold" FontSize="18" Text="Training anlegen" />
                            <TextBlock Margin="0,16,0,4" Text="Name" />
                            <TextBox x:Name="CreateTrainingNameTextBox" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Beschreibung" />
                            <TextBox x:Name="CreateTrainingBeschreibungTextBox" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Datum" />
                            <DatePicker x:Name="CreateTrainingZeitpunktPicker" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Verein" />
                            <ComboBox x:Name="CreateTrainingVereinComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock Margin="0,12,0,4" Text="Disziplin" />
                            <ComboBox x:Name="CreateTrainingDisziplinComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock Margin="0,12,0,4" Text="Wetter" />
                            <ComboBox x:Name="CreateTrainingWetterComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                             <CheckBox x:Name="CreateTrainingAbgeschlossenCheckBox" x:FieldModifier="internal" Margin="0,12,0,0" Content="Training abgeschlossen" />
                             <CheckBox x:Name="CreateTrainingIstVeroeffentlichtCheckBox" x:FieldModifier="internal" Margin="0,8,0,0" Content="Training veröffentlichen" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120"  Height="30"  Margin="0,0,8,0" Click="CancelTrainingPage_OnClick" Content="Abbrechen" />
                                <Button Style="{StaticResource RoundedButton}" Background="green" Width="120" Height="30"  Click="SaveCreateTraining_OnClick" Content="Speichern" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TrainingEditPage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                        <StackPanel Margin="20">
                            <TextBlock FontWeight="Bold" FontSize="18" Text="Training bearbeiten" />
                            <TextBlock Margin="0,16,0,4" Text="Name" />
                            <TextBox x:Name="EditTrainingNameTextBox" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Beschreibung" />
                            <TextBox x:Name="EditTrainingBeschreibungTextBox" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Datum" />
                            <DatePicker x:Name="EditTrainingZeitpunktPicker" x:FieldModifier="internal" Height="30" />
                            <TextBlock Margin="0,12,0,4" Text="Verein" />
                            <ComboBox x:Name="EditTrainingVereinComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock Margin="0,12,0,4" Text="Disziplin" />
                            <ComboBox x:Name="EditTrainingDisziplinComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock Margin="0,12,0,4" Text="Wetter" />
                            <ComboBox x:Name="EditTrainingWetterComboBox" x:FieldModifier="internal" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                             <CheckBox x:Name="EditTrainingAbgeschlossenCheckBox" x:FieldModifier="internal" Margin="0,12,0,0" Content="Training abgeschlossen" />
                             <CheckBox x:Name="EditTrainingIstVeroeffentlichtCheckBox" x:FieldModifier="internal" Margin="0,8,0,0" Content="Training veröffentlichen" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30"  Margin="0,0,8,0" Click="CancelTrainingPage_OnClick" Content="Abbrechen" />
                                <Button Style="{StaticResource RoundedButton}" Background="green" Width="120" Height="30"  Click="SaveEditTraining_OnClick" Content="Speichern" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TrainingDeletePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                        <StackPanel Margin="20">
                            <TextBlock FontWeight="Bold" FontSize="18" Text="Training loeschen" />
                            <TextBlock Margin="0,16,0,0" Text="Soll dieses Training wirklich geloescht werden?" />
                            <TextBlock x:Name="DeleteTrainingTextBlock" x:FieldModifier="internal" Margin="0,10,0,0" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Width="120" Height="30" Margin="0,0,8,0" Click="CancelTrainingPage_OnClick" Content="Abbrechen" />
                                <Button Width="120" Height="30" Background="#DC2626" Foreground="White" BorderThickness="0" Click="ConfirmDeleteTraining_OnClick" Content="Loeschen" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="TrainingStatisticsPage" x:FieldModifier="internal" Visibility="Collapsed" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="TrainingStatisticsScrollViewer" x:FieldModifier="internal" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock x:Name="TrainingStatisticsTitleTextBlock" x:FieldModifier="internal" FontSize="24" FontWeight="Bold" Text="Training" />

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TrainingStatisticsParticipantsTextBlock" x:FieldModifier="internal" Grid.Row="0" Text="Teilnehmer: -" FontSize="14" />
                        <TextBlock x:Name="TrainingStatisticsTimeRangeTextBlock" x:FieldModifier="internal" Grid.Row="1" Text="Uhrzeit: -" FontSize="18" Foreground="DarkGray"/>
                    </Grid>


                    <DataGrid x:Name="TrainingStatisticsBestLapsDataGrid" x:FieldModifier="internal"
                              Margin="0,14,0,0"
                              ItemsSource="{Binding TrainingStatisticsBestLapItems}"
                              PreviewMouseWheel="TrainingStatisticsDataGrid_OnPreviewMouseWheel"
                              Background="Transparent"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              MinRowHeight="36"
                              VerticalContentAlignment="Center"
                              SelectionMode="Single"
                              AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                              CellStyle="{StaticResource StandardDataGridCellStyle}"
                              RowStyle="{StaticResource StandardDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Klasse" Binding="{Binding Klasse}" Width="10*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Fahrer" Binding="{Binding Fahrer}" Width="15*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Kart" Binding="{Binding Kart}" Width="11*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Bestzeit" Binding="{Binding Bestzeit}" Width="9*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Abstand" Binding="{Binding Abstand}" Width="9*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Ø-Zeit" Binding="{Binding Durchschnittszeit}" Width="12*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Runden" Binding="{Binding GefahreneRunden}" Width="10*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                            <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding ZeitpunktLetzteFahrt}" Width="12*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Foreground="#334155" Text="Runden pro Fahrer" />
                    <ItemsControl ItemsSource="{Binding TrainingStatisticsDriverSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,8,0,0" Padding="10" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Titel}" />
                                        <DataGrid Margin="0,8,0,0"
                                                  ItemsSource="{Binding LapItems}"
                                                  PreviewMouseWheel="TrainingStatisticsDataGrid_OnPreviewMouseWheel"
                                                  Background="Transparent"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="None"
                                                  BorderThickness="0"
                                                  RowHeaderWidth="0"
                                                  MinRowHeight="32"
                                                  VerticalContentAlignment="Center"
                                                  SelectionMode="Single"
                                                  AlternationCount="2"
                                                  ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                                  CellStyle="{StaticResource StandardDataGridCellStyle}"
                                                  RowStyle="{StaticResource StandardDataGridRowStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Nummer}" Width="50" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Stint" Binding="{Binding Stint}" Width="70" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Runde" Binding="{Binding Runde}" Width="70" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Kart" Binding="{Binding Kart}" Width="14*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Zeit" Binding="{Binding Zeit}" Width="11*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Strafe" Binding="{Binding StrafeText}" Width="11*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}">
                                                    <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True" Binding="{Binding StrafeSekunden, Converter={StaticResource GreaterThanZeroConverter}}">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="P" Binding="{Binding P}" Width="60" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="T" Binding="{Binding T}" Width="60" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Zeitpunkt}" Width="10*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="TrainingDetailPage" x:FieldModifier="internal" Visibility="Collapsed" Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="0" CornerRadius="10">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TrainingDetailTitleTextBlock" x:FieldModifier="internal" FontSize="24" FontWeight="Bold" Text="Training" />
                        <TextBlock x:Name="TrainingDetailSubtitleTextBlock" x:FieldModifier="internal" Margin="0,6,0,0" FontSize="13" Foreground="#475569" Text="Detailansicht" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="10,2,5,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TrainingDetailStatusTextBlock" x:FieldModifier="internal" FontWeight="SemiBold" Margin="0,2,0,0" Text="Status: -" />
                                <TextBlock x:Name="TrainingDetailZeitpunktTextBlock" x:FieldModifier="internal" Margin="0,4,0,0" Text="Datum: -" />
                                <TextBlock x:Name="TrainingDetailVereinTextBlock" x:FieldModifier="internal" Margin="0,4,0,0" Text="Verein: -" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TrainingDetailDisziplinTextBlock" x:FieldModifier="internal" Margin="0,2,0,0" Text="Disziplin: -" />
                                <TextBlock x:Name="TrainingDetailWetterTextBlock" x:FieldModifier="internal" Margin="0,4,0,0" Text="Wetter: -" />
                                <TextBlock x:Name="TrainingDetailBeschreibungTextBlock" x:FieldModifier="internal" Margin="0,4,0,0" TextWrapping="Wrap" Text="Beschreibung: -" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="17*" />
                        <ColumnDefinition Width="10*" />
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="NextDriverButton" x:FieldModifier="internal" Grid.Column="0" Style="{StaticResource RoundedButton}" Background="#64748B" Margin="8" IsEnabled="False" Click="NextTrainingDriver_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="Nächster Fahrer" />
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="2" Background="White">
                                            <TextBlock Foreground="Black" FontSize="11" Text="Ctrl+S" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SkipDriverButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource RoundedButton}" Background="#DC2626" Margin="8" Click="SkipTrainingDriver_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="Fahrer überspringen" />
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="2" Background="White">
                                            <TextBlock Foreground="Black" FontSize="11" Text="Ctrl+D" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FinishTrainingButton" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource RoundedButton}" Background="#DC2626" Content="Training beenden" Margin="8" Click="FinishTraining_OnClick"/>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,10,10,10" ItemContainerStyle="{StaticResource RoundedTabItemStyle}">
                            <TabItem>
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Text="&#xE716;" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Starterliste" />
                                    </Grid>
                                </TabItem.Header>
                                <Grid Margin="10">
                                     <DataGrid x:Name="TrainingStarterDataGrid" x:FieldModifier="internal"
                                               ItemsSource="{Binding TrainingStarterListItems}"
                                               ToolTip="Doppelklick weist den Fahrer der ersten verfügbaren Zeitnahme zu."
                                               AllowDrop="True"
                                               PreviewMouseLeftButtonDown="TrainingStarterDataGrid_OnPreviewMouseLeftButtonDown"
                                               PreviewMouseMove="TrainingStarterDataGrid_OnPreviewMouseMove"
                                               DragOver="TrainingStarterDataGrid_OnDragOver"
                                               Drop="TrainingStarterDataGrid_OnDrop"
                                               Background="Transparent"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="None"
                                              BorderThickness="0"
                                              RowHeaderWidth="0"
                                              MinRowHeight="36"
                                              VerticalContentAlignment="Center"
                                              SelectionMode="Single"
                                              AlternationCount="2"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                              CellStyle="{StaticResource StandardDataGridCellStyle}">
                                         <DataGrid.RowStyle>
                                             <Style TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRowStyle}">
                                                 <EventSetter Event="MouseDoubleClick" Handler="TrainingStarterRow_OnMouseDoubleClick" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsAktiv}" Value="True">
                                                         <Setter Property="Background" Value="#00BB00" />
                                                         <Setter Property="FontWeight" Value="SemiBold" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding IsAktivZweiteZeitnahme}" Value="True">
                                                         <Setter Property="Background" Value="#F59E0B" />
                                                         <Setter Property="FontWeight" Value="SemiBold" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                                         <Setter Property="Background" Value="#BFDBFE" />
                                                         <Setter Property="BorderBrush" Value="#1F84DE" />
                                                         <Setter Property="BorderThickness" Value="2" />
                                                         <Setter Property="Cursor" Value="SizeAll" />
                                                         <Setter Property="Opacity" Value="0.65" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nr." Binding="{Binding Nummer}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="12*" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="12*" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="Klasse" Binding="{Binding Altersklasse}" Width="10*" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="Verein" Binding="{Binding VereinName}" Width="18*" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                                            <DataGridTemplateColumn Header="Fahrer fährt" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center"
                                                                  IsChecked="{Binding FahrerFaehrt, Mode=TwoWay}"
                                                                  Click="TrainingStarterFaehrtCheckBox_OnClick" Margin="0,10,0,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Kart" Width="16*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.KartLookupItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding KartId, Mode=TwoWay}"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="True"
                                                                  StaysOpenOnEdit="True"
                                                                  SelectionChanged="TrainingStarterKartComboBox_OnSelectionChanged" Height="28" Margin="0,0,10,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                             </TabItem>
                             <TabItem>
                                 <TabItem.Header>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Text="&#xE9D2;" Margin="0,0,6,0" />
                                         <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Gefahrene Stints" />
                                     </Grid>
                                 </TabItem.Header>
                                 <Grid Margin="10">
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="10" />
                                         <RowDefinition Height="*" />
                                     </Grid.RowDefinitions>

                                     <StackPanel Orientation="Horizontal">
