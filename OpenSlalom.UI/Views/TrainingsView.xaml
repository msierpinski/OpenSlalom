                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource RoundedButton}" Background="green" Width="115" x:Name="TrainingStopwatchStartButton" x:FieldModifier="internal" Click="TrainingStopwatchStart_OnClick" Margin="0,0,5,0">
