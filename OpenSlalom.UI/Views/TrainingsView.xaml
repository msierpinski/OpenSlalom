                                          GridLinesVisibility="None"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          MinRowHeight="36"
                                          VerticalContentAlignment="Center"
                                          SelectionMode="Single"
                                          AlternationCount="2"
                                          ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                                          CellStyle="{StaticResource StandardDataGridCellStyle}"
                                          RowStyle="{StaticResource StandardDataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Nummer}" Width="40" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                                        <DataGridTextColumn Header="⭮ Zeit" Binding="{Binding RundenzeitText}" Width="8*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                                        <DataGridTextColumn Header="Zeitstrafe" Binding="{Binding ZeitstrafeSekunden, Converter={StaticResource ZeitstrafeConverter}}" Width="10*" IsReadOnly="True" ElementStyle="{StaticResource StandardDataGridTextElementStyle}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource StandardDataGridCellStyle}">
