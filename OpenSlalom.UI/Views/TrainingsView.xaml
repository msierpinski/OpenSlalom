                                        <Button x:Name="TrainingSecondStartButton" x:FieldModifier="internal" Style="{StaticResource RoundedButton}" Background="#00AA00" Width="105" Margin="0,0,5,0" Click="TrainingSecondStart_OnClick">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Start" /><Border Margin="8,0,0,0" Padding="6,1" Background="White" CornerRadius="2"><TextBlock Foreground="Black" FontSize="11" Text="A" /></Border></StackPanel>
