                                                <TextBlock VerticalAlignment="Center" Text="⏱ Start" />
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="2" Background="White">
                                                    <TextBlock Foreground="Black" FontSize="11" Text="Q" />
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="115" x:Name="TrainingStopwatchStopButton" x:FieldModifier="internal" Click="TrainingStopwatchStop_OnClick" Margin="0,0,5,0">
