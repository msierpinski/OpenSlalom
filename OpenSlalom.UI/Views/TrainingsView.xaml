                                            <DataGridTextColumn Header="Klasse" Binding="{Binding Altersklasse}" Width="9*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                                            <DataGridTextColumn Header="Kart" Binding="{Binding Kart}" Width="140" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                                            <DataGridTextColumn Header="Rundenzeit" Binding="{Binding RundenzeitText}" Width="95" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
