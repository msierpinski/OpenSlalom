                                                                             <DataGridTemplateColumn.CellTemplate>
                                                                                 <DataTemplate>
                                                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                         <TextBlock Width="36" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Pylonen}" />
                                                                                         <StackPanel>
                                                                                             <Button Content="▲" Width="15" Height="18" Padding="0" BorderThickness="0" Background="Transparent" Tag="Pylonen:+1" Click="StoredTrainingLapNumericAdjust_OnClick" />
                                                                                             <Button Content="▼" Width="15" Height="18" Padding="0" BorderThickness="0" Background="Transparent" Tag="Pylonen:-1" Click="StoredTrainingLapNumericAdjust_OnClick" />
                                                                                         </StackPanel>
                                                                                     </StackPanel>
                                                                                 </DataTemplate>
                                                                             </DataGridTemplateColumn.CellTemplate>
                                                                         </DataGridTemplateColumn>
                                                                         <DataGridTemplateColumn Header="TF" Width="90">
                                                                             <DataGridTemplateColumn.CellTemplate>
                                                                                 <DataTemplate>
                                                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                         <TextBlock Width="36" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding Tore}" />
                                                                                         <StackPanel>
                                                                                             <Button Content="▲" Width="15" Height="18" Padding="0" BorderThickness="0" Background="Transparent" Tag="Tore:+1" Click="StoredTrainingLapNumericAdjust_OnClick" />
                                                                                             <Button Content="▼" Width="15" Height="18" Padding="0" BorderThickness="0" Background="Transparent" Tag="Tore:-1" Click="StoredTrainingLapNumericAdjust_OnClick" />
                                                                                         </StackPanel>
                                                                                     </StackPanel>
                                                                                 </DataTemplate>
                                                                             </DataGridTemplateColumn.CellTemplate>
                                                                         </DataGridTemplateColumn>
                                                                         <DataGridTemplateColumn Header="Ungültig" Width="85">
                                                                             <DataGridTemplateColumn.CellTemplate>
                                                                                 <DataTemplate>
                                                                                     <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Ungueltig, Mode=TwoWay}" Click="StoredTrainingLapInvalidCheckBox_OnClick" />
                                                                                 </DataTemplate>
                                                                             </DataGridTemplateColumn.CellTemplate>
                                                                         </DataGridTemplateColumn>
                                                                     </DataGrid.Columns>
                                                                 </DataGrid>
                                                             </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </ScrollViewer>
                                     </Grid>
                                 </Grid>
                             </TabItem>
                             <TabItem>
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Text="&#xE804;" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Karts" />
                                    </Grid>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Text="&#xE823;" Margin="0,0,6,0" />
