                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                     </Grid.RowDefinitions>

                                     <TextBlock Grid.ColumnSpan="2" Text="Rundenanzahl für dieses Training" FontWeight="SemiBold" />
                                     <TextBox x:Name="TrainingRoundsTextBox" x:FieldModifier="internal" Grid.Row="1" Height="30" Width="140" Margin="0,8,0,0" TextChanged="TrainingRoundsTextBox_OnTextChanged" />
                                      <CheckBox x:Name="TrainingAllowExtraRoundsCheckBox" x:FieldModifier="internal" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center" Content="Sollrundenzahl darf überschritten werden" Click="TrainingAllowExtraRoundsCheckBox_OnClick" />
                                      <CheckBox x:Name="TrainingSecondTimingCheckBox" x:FieldModifier="internal" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center" Content="Zweite Zeitnahme aktivieren" Click="TrainingSecondTimingCheckBox_OnClick" />
                                      <CheckBox x:Name="TrainingAutoSyncRemoteDbCheckBox" x:FieldModifier="internal" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center" Content="Gespeicherte Stints automatisch zur Remote-Datenbank synchronisieren" Click="TrainingAutoSyncRemoteDbCheckBox_OnClick" />
                                      <TextBlock x:Name="TrainingRoundsFeedbackTextBlock" x:FieldModifier="internal" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0" Foreground="#475569" Text="" />
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Content="Fahrer hinzufügen" Margin="8" Click="OpenAddTrainingFahrerDialog_OnClick"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="TrainingStopwatchBorder" x:FieldModifier="internal" Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Grid.RowSpan" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TrainingSecondTimingCheckBox}" Value="True">
                                            <Setter Property="Grid.RowSpan" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="85" />
                                    <RowDefinition Height="40" />
