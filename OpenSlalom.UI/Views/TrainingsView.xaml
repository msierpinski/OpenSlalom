                                            <DataGridTextColumn Header="Runden" Binding="{Binding Runden}" Width="80" ElementStyle="{StaticResource StandardDataGridTextElementStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
