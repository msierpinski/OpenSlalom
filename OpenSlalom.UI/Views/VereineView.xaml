<UserControl x:Class="OpenSlalom.UI.Views.VereineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Background="White">
    <Border Background="Transparent">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontWeight="Bold" FontSize="20" Text="Vereine" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource RoundedButton}" Background="#1F84DE" Content="Verein anlegen" Width="120" Height="30" Click="OpenCreateVereinPage_OnClick" />
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid x:Name="VereineDataGrid"
                          ItemsSource="{Binding VereineItems}"
                          Background="Transparent"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          MinRowHeight="36"
                          VerticalContentAlignment="Center"
                          SelectionMode="Single"
                          AlternationCount="2"
                          ColumnHeaderStyle="{StaticResource StandardDataGridHeaderStyle}"
                          CellStyle="{StaticResource StandardDataGridCellStyle}"
                          RowStyle="{StaticResource StandardDataGridRowStyle}">
                    <DataGrid.Columns>
						<DataGridTextColumn Header="Vereinsname" Binding="{Binding Vereinsname}" Width="20*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource StandardDataGridTextElementStyle}">
									<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
									<Setter Property="TextWrapping" Value="NoWrap"/>
									<Setter Property="ToolTip" Value="{Binding VereinName}"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
                        <DataGridTextColumn Header="PLZ" Binding="{Binding Postleitzahl}" Width="6*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Ort" Binding="{Binding Ort}" Width="20*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="20*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTextColumn Header="Mitgliedsnummer" Binding="{Binding MitgliedsNummer}" Width="15*" ElementStyle="{StaticResource StandardDataGridTextElementStyle}" />
                        <DataGridTemplateColumn Header="Logo" Width="9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Height="32" VerticalAlignment="Center">
                                        <Border x:Name="LogoThumbBorder"
                                                Width="42"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFFFFF"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Image Width="36"
                                                   Height="24"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding LogoPreview}" />
                                        </Border>
                                        <Popup IsOpen="{Binding IsMouseOver, ElementName=LogoThumbBorder, Mode=OneWay}"
                                               PlacementTarget="{Binding ElementName=LogoThumbBorder}"
                                               Placement="Right"
                                               HorizontalOffset="8"
                                               VerticalOffset="-8"
                                               AllowsTransparency="True"
                                               StaysOpen="True"
                                               IsHitTestVisible="False">
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6">
                                                <Image Width="220"
                                                       Height="140"
                                                       Stretch="Uniform"
                                                       Source="{Binding LogoPreview}" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aktionen" Width="12*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Height="32" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="1" Height="28" Style="{StaticResource RoundedButtonLeft}" Background="#1F84DE" Tag="{Binding Id}" Click="OpenEditVereinPage_OnClick">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" />
                                        </Button>
                                        <Button Grid.Column="2" Height="28" Style="{StaticResource RoundedButtonRight}" Background="Red" Tag="{Binding Id}" Click="OpenDeleteVereinPage_OnClick">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="VereinCreatePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Verein anlegen" />
                        <TextBlock Margin="0,16,0,4" Text="Mitgliedsnummer" />
                        <TextBox x:Name="CreateMitgliedsNummerTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Vereinsname" />
                        <TextBox x:Name="CreateVereinsnameTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Postleitzahl" />
                        <TextBox x:Name="CreatePostleitzahlTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Ort" />
                        <TextBox x:Name="CreateOrtTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Adresse" />
                        <TextBox x:Name="CreateAdresseTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Logo" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="150" Height="30" Click="SelectCreateVereinLogo_OnClick" Content="Logo auswaehlen" />
                            <Button Style="{StaticResource RoundedButton}" Background="#6B7280" Width="100" Height="30" Margin="8,0,0,0" Click="ClearCreateVereinLogo_OnClick" Content="Entfernen" />
                            <TextBlock x:Name="CreateLogoStatusTextBlock" x:FieldModifier="internal" Margin="10,0,0,0" VerticalAlignment="Center" Text="Kein Logo ausgewaehlt" />
                        </StackPanel>
                        <Image x:Name="CreateVereinLogoPreviewImage" x:FieldModifier="internal" Margin="0,8,0,0" Height="64" Stretch="Uniform" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30" Margin="0,0,8,0" Click="CancelVereinPage_OnClick" Content="Abbrechen" />
                            <Button Style="{StaticResource RoundedButton}" Background="green" Width="120" Height="30" Click="SaveCreateVerein_OnClick" Content="Speichern" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="VereinEditPage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Verein bearbeiten" />
                        <TextBlock Margin="0,16,0,4" Text="Mitgliedsnummer" />
                        <TextBox x:Name="EditMitgliedsNummerTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Vereinsname" />
                        <TextBox x:Name="EditVereinsnameTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Postleitzahl" />
                        <TextBox x:Name="EditPostleitzahlTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Ort" />
                        <TextBox x:Name="EditOrtTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Adresse" />
                        <TextBox x:Name="EditAdresseTextBox" x:FieldModifier="internal" Height="30" />
                        <TextBlock Margin="0,12,0,4" Text="Logo" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="150" Height="30" Click="SelectEditVereinLogo_OnClick" Content="Logo auswaehlen" />
                            <Button Style="{StaticResource RoundedButton}" Background="#6B7280" Width="100" Height="30" Margin="8,0,0,0" Click="ClearEditVereinLogo_OnClick" Content="Entfernen" />
                            <TextBlock x:Name="EditLogoStatusTextBlock" x:FieldModifier="internal" Margin="10,0,0,0" VerticalAlignment="Center" Text="Kein Logo ausgewaehlt" />
                        </StackPanel>
                        <Image x:Name="EditVereinLogoPreviewImage" x:FieldModifier="internal" Margin="0,8,0,0" Height="64" Stretch="Uniform" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Style="{StaticResource RoundedButton}" Background="#1F84DE" Width="120" Height="30" Margin="0,0,8,0" Click="CancelVereinPage_OnClick" Content="Abbrechen" />
                            <Button Style="{StaticResource RoundedButton}" Background="green" Width="120" Height="30" Click="SaveEditVerein_OnClick" Content="Speichern" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="VereinDeletePage" x:FieldModifier="internal" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
                    <StackPanel Margin="20">
                        <TextBlock FontWeight="Bold" FontSize="18" Text="Verein loeschen" />
                        <TextBlock Margin="0,16,0,0" Text="Soll dieser Verein wirklich geloescht werden?" />
                        <TextBlock x:Name="DeleteVereinTextBlock" x:FieldModifier="internal" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Width="120" Height="30" Style="{StaticResource RoundedButton}" Background="#1F84DE" Margin="0,0,8,0" Click="CancelVereinPage_OnClick" Content="Abbrechen" />
                            <Button Width="120" Height="30" Style="{StaticResource RoundedButton}" Background="red" Foreground="White" BorderThickness="0" Click="ConfirmDeleteVerein_OnClick" Content="Loeschen" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
