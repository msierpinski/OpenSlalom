FROM "disziplin" AS "d"
LEFT JOIN (
    SELECT "d0"."id", "d0"."alter_bis", "d0"."alter_von", "d0"."bezeichnung", "d0"."deleted_at_utc", "d0"."fk_id_disziplin", "d0"."is_deleted", "d0"."updated_at_utc"
    FROM "disziplin_altersklassen" AS "d0"
    WHERE NOT ("d0"."is_deleted")
) AS "t" ON "d"."id" = "t"."fk_id_disziplin"
WHERE NOT ("d"."is_deleted")
ORDER BY "d"."disziplin", "d"."id"
