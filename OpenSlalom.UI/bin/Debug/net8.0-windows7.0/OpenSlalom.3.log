SELECT "t"."id", "t"."fk_id_verein", "t"."fk_id_disziplin", "t"."fk_id_wetter", "t"."name", "t"."beschreibung", "t"."zeitpunkt", "t"."training_abgeschlossen", CASE
    WHEN "t"."training_abgeschlossen" THEN 'Ja'
    ELSE 'Nein'
END, "t0"."vereinsname", "t1"."disziplin", "t2"."wetter"
FROM "training" AS "t"
INNER JOIN (
    SELECT "v"."id", "v"."vereinsname"
    FROM "vereine" AS "v"
    WHERE NOT ("v"."is_deleted")
) AS "t0" ON "t"."fk_id_verein" = "t0"."id"
INNER JOIN (
    SELECT "d"."id", "d"."disziplin"
    FROM "disziplin" AS "d"
    WHERE NOT ("d"."is_deleted")
) AS "t1" ON "t"."fk_id_disziplin" = "t1"."id"
INNER JOIN (
    SELECT "w"."id", "w"."wetter"
    FROM "wetter" AS "w"
    WHERE NOT ("w"."is_deleted")
) AS "t2" ON "t"."fk_id_wetter" = "t2"."id"
WHERE NOT ("t"."is_deleted")
ORDER BY "t"."zeitpunkt" DESC, "t"."name"
